---
import { getImage } from "astro:assets";
import heroImage from "../assets/hero-dairy.jpg";
import MeshGradient from "./MeshGradient.astro";
import ScrollHero from "./react/ScrollHero";
import { SITE } from "../data/site";

const optimized = await getImage({ src: heroImage, format: "avif", width: 1920 });
---

<section class="relative isolate overflow-hidden bg-[var(--color-surface-dark)] text-[var(--color-body-dark)]">
  <MeshGradient />
  <ScrollHero
    client:load
    imageSrc={optimized.src}
    eyebrow={SITE.subTagline}
    heading={SITE.tagline}
    body="A platform of food professionals providing expert advice and technical guidance to restaurants, food manufacturers, and foodservice companies worldwide."
  />
</section>
